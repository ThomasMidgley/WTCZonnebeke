# Kopieer naar Portainer > Stack > Environment variables. Nooit in Git zetten.

# Verplicht: lange willekeurige tekst, bv. via: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Testomgeving. Bij de overstap naar productie: wtc-zonnebeke.be en SITE_NOINDEX=0.
ALLOWED_HOSTS=wtczonnebeke.be,www.wtczonnebeke.be
CSRF_TRUSTED_ORIGINS=https://wtczonnebeke.be,https://www.wtczonnebeke.be
BASE_URL=https://www.wtczonnebeke.be
SITE_NOINDEX=1

# Microsoft 365 (app-registratie "WTC Website"). Tenant- en client-ID kunnen ook op de instellingenpagina.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Wie altijd beheerder is, ook als de instellingenpagina leeg is (komma's ertussen).
BOOTSTRAP_ADMIN_EMAILS=
# Enkel in nood (SSO werkt niet): 1, en maak een gebruiker met "python manage.py createsuperuser".
ALLOW_PASSWORD_LOGIN=0

# Startwaarden voor Instellingen > Toegang en Integraties (enkel bij de eerste start).
SEED_STOCK_EMAILS=

# Fase 2 en 3
CYQL_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optioneel: captcha op de formulieren (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optioneel
# Naam van het Docker-netwerk waarin cloudflared zit.
TUNNEL_NETWORK=tunnel
BACKUP_TIME=02:30
GUNICORN_WORKERS=2
IMAGE_TAG=main
